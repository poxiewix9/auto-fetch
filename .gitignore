# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# REAL-INBOX ARTIFACTS — never commit. This repo is public; everything below
# contains verbatim message bodies, recruiter names, or a personal application
# history. Only sanitized, fully-synthetic fixtures belong in eval/fixtures/.
# ---------------------------------------------------------------------------
# eval fixtures derived from a real inbox stay local unless explicitly shared;
# the harness auto-loads any eval/fixtures/*.json present.
/eval/fixtures/real.json
/eval/fixtures/real-gmail.json
# quarantined records awaiting user adjudication (real-inbox content)
/eval/pending-review.json
# raw ground-truth dataset exported from a real Gmail account (verbatim bodies)
/tally_fixtures.json
# local handoff/session notes — reference real companies applied to
/STATUS.md
/eval/LOOP-PROMPT.md

# local operator scripts (reset/reclassify/replay against prod creds)
/scripts/

# local board-diff report (contains application history)
/BOARD-DIFF.txt

# eval report / analysis references real-inbox companies + evidence quotes
/eval/REPORT.md
