# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eval fixtures derived from a real inbox stay local unless explicitly shared;
# the harness auto-loads any eval/fixtures/*.json present.
/eval/fixtures/real.json

# local operator scripts (reset/reclassify/replay against prod creds)
/scripts/

# local board-diff report (contains application history)
/BOARD-DIFF.txt
