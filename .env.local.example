# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service role key (server only!) used by the scheduled /api/sync/cron job.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---- Google OAuth (same client you configure in Supabase Auth -> Providers -> Google) ----
# Needed server-side to refresh the Gmail access token for background syncing.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ---- Optional: LLM classification ----
# If configured, emails are classified with an LLM for much better company/role
# extraction and noise filtering. Leave LLM_PROVIDER blank for rules-only.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ---- Encryption key for Gmail refresh tokens at rest (AES-256-GCM) ----
# REQUIRED in production. 32 bytes, base64 or hex. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Protect the cron sync endpoint (REQUIRED in production) ----
# Bearer token for Vercel Cron / external schedulers hitting /api/sync/cron.
# Vercel injects this automatically when set. Generate with: openssl rand -hex 32
CRON_SECRET=
