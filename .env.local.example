# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service role key (server only!) used by the scheduled /api/sync/cron job.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---- Google OAuth (same client you configure in Supabase Auth -> Providers -> Google) ----
# Needed server-side to refresh the Gmail access token for background syncing.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ---- Optional: LLM classification ----
# If configured, emails are classified with an LLM for much better company/role
# extraction and noise filtering. Leave LLM_PROVIDER blank for rules-only.
#
# HOW TO GET YOUR OWN KEY (each person needs their own — never share/commit one):
#   1. Sign in at https://aistudio.google.com/apikey with any Google account.
#   2. "Create API key" -> pick a Google Cloud project (or let it make one).
#   3. Copy the key (starts with "AIza...") into GEMINI_API_KEY below, in your
#      OWN .env.local. That file is gitignored and must stay that way.
#   4. Deploying? Put the same values in Vercel -> Project -> Settings ->
#      Environment Variables (Production + Preview), then redeploy. Vercel does
#      NOT read .env.local.
#   5. Rotating/replacing a key: delete the old key in AI Studio FIRST, then
#      paste the new one here and in Vercel. A leaked key is billable by whoever
#      finds it.
#
# MODEL CHOICE — read this, the default matters:
#   gemini-2.5-flash       <- recommended. Reliable in practice.
#   gemini-2.5-flash-lite  <- cheaper, but has been observed in multi-hour
#                             brownouts returning 503 on every real batch while
#                             a trivial call still succeeds. When that happens
#                             the app silently classifies with RULES ONLY, which
#                             is noticeably worse. Not a key or quota problem.
# The free tier will 429 on large syncs regardless of model; that also falls
# back to rules. Check server logs for "[classifier] gemini" warnings to see how
# often the LLM path is actually being used.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Encryption key for Gmail refresh tokens at rest (AES-256-GCM) ----
# REQUIRED in production. 32 bytes, base64 or hex. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Protect the cron sync endpoint (REQUIRED in production) ----
# Bearer token for Vercel Cron / external schedulers hitting /api/sync/cron.
# Vercel injects this automatically when set. Generate with: openssl rand -hex 32
CRON_SECRET=
